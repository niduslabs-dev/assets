{
  "$description": "Nidus Labs design tokens. Design Tokens Format Module 2025.10 (DTCG). The single source: brand values, and the roles every app shares. Generated outputs live in dist/tokens; never edit them.",
  "$extensions": {
    "dev.niduslabs.brand": {
      "name": "Nidus Labs",
      "byline": "A home for little ideas.",
      "wordmark": { "source": "https://fonts.google.com/specimen/Manrope", "tracking": "-0.02em" },
      "apps": {
        "splito": { "name": "Splito", "tagline": "Split & track expenses" }
      }
    },
    "dev.niduslabs.modes": {
      "$value": "light",
      "dark": "dark appearance",
      "lightContrast": "light with Increase Contrast",
      "darkContrast": "dark with Increase Contrast",
      "fallback": "a mode a token leaves out falls back: darkContrast to dark, lightContrast and dark to $value"
    }
  },
  "color": {
    "$type": "color",
    "brand": {
      "$description": "The brand palette. Roles below are built from these; views use roles, never these.",
      "ink": { "$value": {"colorSpace": "srgb", "components": [0.0902, 0.0863, 0.1098], "hex": "#17161C"}, "$description": "The tile, text, dark grounds." },
      "paper": { "$value": {"colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "hex": "#F4F4F6"}, "$description": "Light grounds; the tile on dark." },
      "moss": { "$value": {"colorSpace": "srgb", "components": [0.3098, 0.4784, 0.2902], "hex": "#4F7A4A"}, "$description": "The seed on light; the one action colour." },
      "mossOnDark": { "$value": {"colorSpace": "srgb", "components": [0.5529, 0.7333, 0.5098], "hex": "#8DBB82"}, "$description": "The seed, links and accent icons on dark." },
      "muted": { "$value": {"colorSpace": "srgb", "components": [0.4196, 0.4157, 0.451], "hex": "#6B6A73"}, "$description": "'Labs' in the wordmark and brand secondary text on light. UI secondary text is role.textSecondary." },
      "mutedOnDark": { "$value": {"colorSpace": "srgb", "components": [0.7255, 0.7216, 0.7608], "hex": "#B9B8C2"}, "$description": "The same, on dark." }
    },
    "role": {
      "$description": "Colours named by job. Each has light, dark and Increase Contrast values.",
      "textPrimary": {
        "$value": { "colorSpace": "srgb", "components": [0.0902, 0.0863, 0.1098], "hex": "#17161C" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "hex": "#F4F4F6" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.0, 0.0, 0.0], "hex": "#000000" },
            "darkContrast": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" }
          }
        },
        "$description": "Body text and titles."
      },
      "textSecondary": {
        "$value": { "colorSpace": "srgb", "components": [0.3922, 0.3882, 0.4235], "hex": "#64636C" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.7255, 0.7216, 0.7608], "hex": "#B9B8C2" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.2431, 0.2392, 0.2706], "hex": "#3E3D45" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.8627, 0.8588, 0.8902], "hex": "#DCDBE3" }
          }
        },
        "$description": "Captions, meta, group labels. Muted darkened until 4.5:1 is measured on every surface."
      },
      "link": {
        "$value": { "colorSpace": "srgb", "components": [0.2745, 0.4314, 0.2549], "hex": "#466E41" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.5529, 0.7333, 0.5098], "hex": "#8DBB82" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.2314, 0.3647, 0.2196], "hex": "#3B5D38" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.6627, 0.8196, 0.6235], "hex": "#A9D19F" }
          }
        },
        "$description": "Links and accent icons. A moss shade that clears 4.5:1."
      },
      "actionPrimary": {
        "$value": { "colorSpace": "srgb", "components": [0.3098, 0.4784, 0.2902], "hex": "#4F7A4A" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.3098, 0.4784, 0.2902], "hex": "#4F7A4A" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.2314, 0.3647, 0.2196], "hex": "#3B5D38" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.2314, 0.3647, 0.2196], "hex": "#3B5D38" }
          }
        },
        "$description": "The fill of the one primary action per surface."
      },
      "actionPrimaryHover": {
        "$value": { "colorSpace": "srgb", "components": [0.2706, 0.4196, 0.2549], "hex": "#456B41" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.3216, 0.498, 0.298], "hex": "#527F4C" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.2039, 0.3216, 0.1843], "hex": "#34522F" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.2314, 0.3647, 0.2196], "hex": "#3B5D38" }
          }
        },
        "$description": "Primary fill under the pointer. Lighter on dark."
      },
      "actionPrimaryPressed": {
        "$value": { "colorSpace": "srgb", "components": [0.2314, 0.3647, 0.2196], "hex": "#3B5D38" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.2706, 0.4196, 0.2549], "hex": "#456B41" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.1725, 0.2706, 0.1608], "hex": "#2C4529" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.2039, 0.3216, 0.1843], "hex": "#34522F" }
          }
        },
        "$description": "Primary fill while pressed."
      },
      "onAction": { "$value": {"colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF"}, "$description": "Label on the primary fill. 4.9:1 on moss." },
      "actionSecondary": {
        "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "hex": "#F4F4F6" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.1725, 0.1686, 0.2], "alpha": 0.9, "hex": "#2C2B33" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "hex": "#F4F4F6" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.1725, 0.1686, 0.2], "hex": "#2C2B33" }
          }
        },
        "$description": "Secondary button fill, with a hairline."
      },
      "surfaceBase": {
        "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.1098, 0.1059, 0.1333], "alpha": 0.86, "hex": "#1C1B22" },
            "lightContrast": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.1373, 0.1333, 0.1608], "hex": "#232229" }
          }
        },
        "$description": "Window and panel background, including the title bar. Dark is ink glass over a behind-window blur."
      },
      "surfaceBaseSolid": {
        "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.1373, 0.1333, 0.1608], "hex": "#232229" }
          }
        },
        "$description": "surfaceBase with Reduce Transparency on, or where no blur is drawn."
      },
      "surfaceCard": {
        "$value": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "hex": "#F4F4F6" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "alpha": 0.06, "hex": "#F4F4F6" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "hex": "#F4F4F6" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "alpha": 0.12, "hex": "#F4F4F6" }
          }
        },
        "$description": "Cards inside a window. No shadow."
      },
      "surfaceRaised": {
        "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.1725, 0.1686, 0.2], "alpha": 0.9, "hex": "#2C2B33" },
            "lightContrast": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.1725, 0.1686, 0.2], "hex": "#2C2B33" }
          }
        },
        "$description": "Selects, fields, popover rows."
      },
      "surfaceMenu": {
        "$value": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.1412, 0.1373, 0.1686], "alpha": 0.96, "hex": "#24232B" },
            "lightContrast": { "colorSpace": "srgb", "components": [1.0, 1.0, 1.0], "hex": "#FFFFFF" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.1412, 0.1373, 0.1686], "hex": "#24232B" }
          }
        },
        "$description": "Menu panels. Dark sits over a behind-window blur."
      },
      "hairline": {
        "$value": { "colorSpace": "srgb", "components": [0.0902, 0.0863, 0.1098], "alpha": 0.12, "hex": "#17161C" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "alpha": 0.12, "hex": "#F4F4F6" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.3686, 0.3647, 0.4], "hex": "#5E5D66" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.6275, 0.6235, 0.6588], "hex": "#A09FA8" }
          }
        },
