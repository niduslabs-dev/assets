      },
      "track": {
        "$value": { "colorSpace": "srgb", "components": [0.0902, 0.0863, 0.1098], "alpha": 0.08, "hex": "#17161C" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.9569, 0.9569, 0.9647], "alpha": 0.1, "hex": "#F4F4F6" }
          }
        },
        "$description": "A progress bar's unfilled part."
      },
      "scrim": {
        "$value": { "colorSpace": "srgb", "components": [0.0902, 0.0863, 0.1098], "alpha": 0.2, "hex": "#17161C" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.0, 0.0, 0.0], "alpha": 0.36, "hex": "#000000" }
          }
        },
        "$description": "Dim over a window behind a sheet."
      },
      "disabledFill": {
        "$value": { "colorSpace": "srgb", "components": [0.7882, 0.7843, 0.8118], "hex": "#C9C8CF" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.2902, 0.2863, 0.3216], "hex": "#4A4952" }
          }
        },
        "$description": "A disabled primary on the kit board. In code, disabled is opacity.disabled on the live control."
      },
      "status": {
        "success": {
          "$value": { "colorSpace": "srgb", "components": [0.1843, 0.4784, 0.2275], "hex": "#2F7A3A" },
          "$extensions": {
            "dev.niduslabs.modes": {
              "dark": { "colorSpace": "srgb", "components": [0.1843, 0.4784, 0.2275], "hex": "#2F7A3A" },
              "lightContrast": { "colorSpace": "srgb", "components": [0.1333, 0.3608, 0.1686], "hex": "#225C2B" },
              "darkContrast": { "colorSpace": "srgb", "components": [0.1333, 0.3608, 0.1686], "hex": "#225C2B" }
            }
          },
          "$description": "Fill of a done badge. White on it is 5.3:1."
        },
        "good": {
