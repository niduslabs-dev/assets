          "$extensions": {
            "dev.niduslabs.modes": {
              "dark": { "colorSpace": "srgb", "components": [0.5529, 0.7333, 0.5098], "hex": "#8DBB82" },
              "lightContrast": { "colorSpace": "srgb", "components": [0.1333, 0.3608, 0.1686], "hex": "#225C2B" },
              "darkContrast": { "colorSpace": "srgb", "components": [0.6627, 0.8196, 0.6235], "hex": "#A9D19F" }
            }
          },
          "$description": "Green status icons and text."
