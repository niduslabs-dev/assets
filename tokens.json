            "lightContrast": { "colorSpace": "srgb", "components": [0.3098, 0.4784, 0.2902], "alpha": 0.2, "hex": "#4F7A4A" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.5529, 0.7333, 0.5098], "alpha": 0.3, "hex": "#8DBB82" }
          }
        },
