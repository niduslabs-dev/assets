  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "brand": { "$value": "Manrope", "$description": "Wordmark, byline and onboarding headings only." },
      "system": { "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Text", "system-ui", "sans-serif"], "$description": "Everything else. SF Pro on Apple platforms." },
      "rounded": { "$value": ["ui-rounded", "SF Pro Rounded", "-apple-system", "system-ui", "sans-serif"], "$description": "Numbers that change, and big figures." },
      "mono": { "$value": ["ui-monospace", "SF Mono", "Menlo", "monospace"], "$description": "File paths." }
    },
    "wordmark": {
      "$type": "fontWeight",
      "nidus": { "$value": 800 },
      "labs": { "$value": 500 }
    }
  },
  "space": {
    "$type": "dimension",
    "$description": "The spacing scale. Every gap and inset is one of these; anything off the scale needs a comment naming the optical fix.",
    "xxxs": { "$value": {"value": 2, "unit": "px"}, "$description": "hairline gaps; caption under title" },
    "xxs": { "$value": {"value": 4, "unit": "px"}, "$description": "group-label inset" },
    "xs": { "$value": {"value": 6, "unit": "px"}, "$description": "label to card; title to info icon" },
    "s": { "$value": {"value": 8, "unit": "px"}, "$description": "between buttons and list cards" },
    "m": { "$value": {"value": 12, "unit": "px"}, "$description": "row vertical padding; stacked buttons" },
    "l": { "$value": {"value": 16, "unit": "px"}, "$description": "row horizontal padding; between groups; divider inset" },
    "xl": { "$value": {"value": 24, "unit": "px"}, "$description": "window content inset; sheet padding" },
    "xxl": { "$value": {"value": 32, "unit": "px"}, "$description": "page title to first group" }
  },
  "type": {
    "$description": "The type scale. System font; Manrope only for brand moments.",
    "display": {
      "$description": "the one big figure on a moment screen (rounded, monospaced digits)",
      "family": { "$type": "fontFamily", "$value": "{font.family.rounded}" },
      "size": { "$type": "dimension", "$value": {"value": 56, "unit": "px"} },
      "weight": { "$type": "fontWeight", "$value": 700 }
    },
    "hero": {
      "$description": "a headline figure on a page (rounded)",
      "family": { "$type": "fontFamily", "$value": "{font.family.rounded}" },
      "size": { "$type": "dimension", "$value": {"value": 36, "unit": "px"} },
      "weight": { "$type": "fontWeight", "$value": 700 }
    },
    "title": {
      "$description": "onboarding and moment titles (Manrope 26 bold on onboarding)",
      "family": { "$type": "fontFamily", "$value": "{font.family.system}" },
      "size": { "$type": "dimension", "$value": {"value": 26, "unit": "px"} },
      "weight": { "$type": "fontWeight", "$value": 600 }
    },
