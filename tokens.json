      },
      "focusRing": {
        "$value": { "colorSpace": "srgb", "components": [0.3098, 0.4784, 0.2902], "hex": "#4F7A4A" },
        "$extensions": {
          "dev.niduslabs.modes": {
            "dark": { "colorSpace": "srgb", "components": [0.5529, 0.7333, 0.5098], "hex": "#8DBB82" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.2314, 0.3647, 0.2196], "hex": "#3B5D38" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.6627, 0.8196, 0.6235], "hex": "#A9D19F" }
