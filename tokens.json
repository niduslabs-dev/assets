              "lightContrast": { "colorSpace": "srgb", "components": [0.5412, 0.2824, 0.0], "hex": "#8A4800" },
              "darkContrast": { "colorSpace": "srgb", "components": [1.0, 0.7608, 0.4784], "hex": "#FFC27A" }
