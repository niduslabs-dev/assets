            "dark": { "colorSpace": "srgb", "components": [0.4784, 0.4745, 0.5137], "hex": "#7A7983" },
            "lightContrast": { "colorSpace": "srgb", "components": [0.3686, 0.3647, 0.4], "hex": "#5E5D66" },
            "darkContrast": { "colorSpace": "srgb", "components": [0.6275, 0.6235, 0.6588], "hex": "#A09FA8" }
          }
        },
